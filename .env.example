# ===== Konfigurasi Server =====
PORT=3000

# ===== Konfigurasi Database MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=portofolio_db

# ===== Mode Development =====
# Jika true, aplikasi tetap berjalan memakai dummy data
# meskipun MySQL belum terkoneksi. (default: true)
DB_FALLBACK=true
