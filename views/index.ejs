<%- include('partials/head') %>
<%- include('partials/header') %>

  <main>
    <!-- ============================================================
         FLASH MESSAGE (feedback form kontak)
    ============================================================ -->
    <% if (flash.status) { %>
      <div
        id="flash-toast"
        class="fixed inset-x-0 top-20 z-40 mx-auto w-fit max-w-md px-4 transition-all duration-300"
      >
        <div class="<%= flash.status === 'success'
            ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
            : 'bg-red-50 border-red-200 text-red-800' %>
          flex items-center gap-3 rounded-xl border px-4 py-3 shadow-lg">
          <i data-lucide="<%= flash.status === 'success' ? 'check-circle-2' : 'alert-circle' %>" class="h-5 w-5 shrink-0"></i>
          <p class="text-sm font-medium"><%= flash.message %></p>
        </div>
      </div>
    <% } %>

    <!-- ============================================================
         HERO — Spider-Verse Modern (Iron Spider)
    ============================================================ -->
    <section id="home" class="relative overflow-hidden bg-white">
      <!-- Jaring laba-laba sangat halus (emas muda di atas putih) — expand dari tengah -->
      <div aria-hidden="true" class="web-pattern web-pattern-anim pointer-events-none absolute inset-0 opacity-[0.07]"></div>

      <!-- Akses web sudut kanan-atas -->
      <svg aria-hidden="true" viewBox="0 0 200 200" fill="none" class="corner-web pointer-events-none absolute -top-10 -right-10 h-64 w-64 text-amber-500/25">
        <g stroke="currentColor" stroke-width="1.5">
          <circle cx="200" cy="0" r="40" />
          <circle cx="200" cy="0" r="80" />
          <circle cx="200" cy="0" r="120" />
          <circle cx="200" cy="0" r="160" />
          <path d="M200 0v200M200 0H0" />
          <path d="M200 0L100 100M200 0L59 59" />
        </g>
      </svg>

      <!-- Akses web sudut kiri-bawah -->
      <svg aria-hidden="true" viewBox="0 0 200 200" fill="none" class="corner-web corner-web-late pointer-events-none absolute -bottom-12 -left-12 h-72 w-72 text-amber-500/20">
        <g stroke="currentColor" stroke-width="1.5">
          <circle cx="0" cy="200" r="40" />
          <circle cx="0" cy="200" r="80" />
          <circle cx="0" cy="200" r="120" />
          <circle cx="0" cy="200" r="160" />
          <path d="M0 200V0M0 200H200" />
          <path d="M0 200L100 100M0 200L141 59" />
        </g>
      </svg>

      <!-- ===== Dekorasi Spider-Verse (di sekeliling hero, minimalis) ===== -->
      <!-- Peter Parker — bergelantung dari tali jaring (kiri atas) -->
      <div class="pointer-events-none absolute top-0 left-6 md:left-[15%]">
        <div class="web-drop flex w-fit flex-col items-center">
          <div class="web-swing flex w-fit flex-col items-center">
            <!-- Tali jaring laba-laba: dari batas atas hero, mendarat tepat di tangan Peter (x≈62% gambar) -->
            <div
              class="relative left-[12%] h-28 w-[3px] bg-gradient-to-b from-amber-400/30 via-slate-100 to-white shadow-[0_0_8px_rgba(255,255,255,0.8)] drop-shadow-[0_0_4px_rgba(251,191,36,0.5)] md:h-32"
            ></div>
            <img
              src="/images/peter.png"
              alt="Peter Parker"
              class="pointer-events-auto w-[120px] h-auto object-contain drop-shadow-lg transition-transform duration-300 hover:scale-110 md:w-40"
            />
            <span class="font-heading mt-2 text-[10px] font-bold uppercase tracking-[0.2em] text-red-900">Peter Parker</span>
          </div>
        </div>
      </div>

      <!-- Miles Morales — bergelantung dari tali jaring (kanan atas) -->
      <div class="pointer-events-none absolute top-0 right-6 md:right-[15%]">
        <div class="web-drop web-drop-delay flex w-fit flex-col items-center">
          <div class="web-swing web-swing-slower flex w-fit flex-col items-center">
            <!-- Tali jaring laba-laba: dari batas atas hero, mendarat tepat di tangan Miles (x≈25% gambar) -->
            <div
              class="relative -left-[24.6%] h-32 w-[3px] bg-gradient-to-b from-amber-400/30 via-slate-100 to-white shadow-[0_0_8px_rgba(255,255,255,0.8)] drop-shadow-[0_0_4px_rgba(251,191,36,0.5)] md:h-36"
            ></div>
            <img
              src="/images/miles.png"
              alt="Miles Morales"
              class="pointer-events-auto w-[120px] h-auto object-contain drop-shadow-lg transition-transform duration-300 hover:scale-110 md:w-40"
            />
            <span class="font-heading mt-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-950">Miles Morales</span>
          </div>
        </div>
      </div>

      <!-- Gwen Stacy (kiri bawah dekat CTA) -->
      <div class="fade-up fade-up-gwen pointer-events-none absolute bottom-24 left-6 hidden md:block lg:left-1/4">
        <div class="animate-float flex flex-col items-center gap-2.5">
          <img
            src="/images/gwen.png"
            alt="Gwen Stacy"
            class="pointer-events-auto w-20 h-auto object-contain drop-shadow-lg transition-transform duration-300 hover:scale-110 md:w-28"
          />
        </div>
      </div>

      <!-- ===== Konten utama hero ===== -->
      <div class="relative mx-auto max-w-6xl px-4 pb-24 pt-32 text-center sm:px-6 sm:pt-36">
        <div class="relative mx-auto mt-4 max-w-sm sm:max-w-md">
          <!-- Teks script 'hi, i'm' di atas kiri foto, sedikit turun dari posisi awal -->
          <p class="font-hand absolute -top-4 -left-2 z-30 -rotate-6 text-5xl text-red-800 sm:-top-6 sm:-left-10 sm:text-6xl">
            <span class="mask-reveal inline-block">
              <span class="mask-reveal-inner inline-block">hi, i'm</span>
            </span>
          </p>

          <!-- Foto profil + efek Spider-Sense (insting) dalam satu kontainer -->
          <div class="photo-rise relative inline-block w-full">
            <img
              src="/images/profile-hero.png"
              alt="Foto profil Bima Respati"
              class="block h-auto w-full object-contain drop-shadow-2xl"
              style="mask-image: linear-gradient(to bottom, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);"
            />
            <!-- Spider-Sense: pusat burst tepat di kepala (x≈48%, y≈34% gambar) -->
            <div class="electric-burst pointer-events-none absolute left-[48%] top-[34%] z-20 w-[280px] -translate-x-1/2 -translate-y-1/2 sm:w-[380px]">
              <img
                src="/images/insting.png"
                alt=""
                aria-hidden="true"
                class="h-auto w-full object-contain drop-shadow-[0_0_6px_rgba(255,255,255,0.6)] animate-insting-pulse"
              />
            </div>
          </div>
        </div>

        <!-- Nama raksasa (overlap tipis di bawah foto) -->
        <h1 class="font-heading relative z-10 -mt-8 text-4xl font-extrabold leading-[0.95] tracking-tighter text-slate-950 sm:-mt-10 sm:text-7xl lg:text-8xl">
          <span class="mask-reveal block">
            <span class="mask-reveal-inner mask-reveal-later block"><%= portfolio.name %></span>
          </span>
        </h1>

        <!-- Garis aksen emas -->
        <span aria-hidden="true" class="line-grow mx-auto mt-7 block h-px w-16 bg-amber-500/70"></span>

        <p class="fade-up mt-6 text-xl font-semibold text-slate-900 sm:text-2xl">
          <%= portfolio.role %>
        </p>

        <p class="fade-up fade-up-later mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          <%= portfolio.tagline %>
        </p>

        <!-- CTA -->
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="#projects"
            class="cta-slide-left inline-flex items-center gap-2 rounded-full bg-red-900 px-8 py-3.5 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-950 hover:shadow-xl"
          >
            Lihat Proyek
            <i data-lucide="arrow-down" class="h-4 w-4"></i>
          </a>
          <a
            href="#contact"
            class="cta-slide-right inline-flex items-center gap-2 rounded-full border border-slate-950 bg-white px-8 py-3.5 text-sm font-semibold text-slate-950 transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-950 hover:text-white"
          >
            Hubungi Saya
            <i data-lucide="mail" class="h-4 w-4"></i>
          </a>
          <a
            href="/CV_Bima_Respati1.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-slide-left inline-flex items-center gap-2 rounded-full border border-amber-500 bg-amber-500/10 px-8 py-3.5 text-sm font-semibold text-amber-800 transition-all duration-300 hover:-translate-y-0.5 hover:bg-amber-500 hover:text-slate-950 hover:shadow-xl hover:shadow-amber-500/30"
          >
            <i data-lucide="file-text" class="h-4 w-4"></i>
            Lihat CV
          </a>
          <a
            href="/CV_Bima_Respati1.pdf"
            download="Bima-Respati-CV.pdf"
            class="cta-slide-left inline-flex items-center gap-2 rounded-full border border-stone-300 bg-white/80 px-6 py-3.5 text-sm font-semibold text-stone-600 transition-all duration-300 hover:-translate-y-0.5 hover:border-amber-500 hover:bg-amber-50 hover:text-amber-800 hover:shadow-lg"
          >
            <i data-lucide="download" class="h-4 w-4"></i>
            Download CV
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         ABOUT — Tentang Saya
    ============================================================ -->
    <section id="about" class="bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-amber-600">Tentang Saya</p>
          <h2 class="font-heading mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
            Membangun dengan logika, berkontribusi untuk tim
          </h2>
          <div class="mt-6 space-y-4 leading-relaxed text-slate-600">
            <% portfolio.about.forEach((paragraph) => { %>
              <p><%= paragraph %></p>
            <% }) %>
          </div>
          <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1.5 text-xs font-semibold text-emerald-700">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            Terbuka untuk PKL · Freelance · Kolaborasi
          </div>
        </div>

        <!-- Highlight singkat -->
        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          <% const highlights = [
            { icon: 'braces',       title: 'Full-Stack & Backend', desc: 'Membangun aplikasi web dengan Node.js, Express, dan SQL.' },
            { icon: 'database',     title: 'Database & API',       desc: 'Merancang REST API dan manajemen basis data relasional.' },
            { icon: 'users',        title: 'Leadership',           desc: 'Berpengalaman memimpin tim dan koordinasi proyek.' },
          ]; %>
          <% highlights.forEach((h) => { %>
            <div class="rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-100 text-red-900">
                <i data-lucide="<%= h.icon %>" class="h-5 w-5"></i>
              </div>
              <h3 class="font-heading mt-4 font-bold text-slate-950"><%= h.title %></h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-500"><%= h.desc %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SKILLS & TOOLS
    ============================================================ -->
    <section id="skills" class="bg-slate-50/70 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-amber-600">Skills & Tools</p>
          <h2 class="font-heading mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">Teknologi yang saya gunakan</h2>
          <p class="mt-4 leading-relaxed text-slate-600">
            Kumpulan bahasa pemrograman, framework, dan tools yang saya kuasai untuk membangun web dan memproduksi konten.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% portfolio.skills.forEach((group) => { %>
            <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <i data-lucide="<%= group.icon %>" class="h-5 w-5"></i>
              </div>
              <h3 class="font-heading mt-4 font-bold text-slate-950"><%= group.category %></h3>
              <ul class="mt-3 space-y-2">
                <% group.items.forEach((item) => { %>
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-amber-600"></i>
                    <span><%= item %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============================================================
         EDUCATION & EXPERIENCE — Timeline
    ============================================================ -->
    <section id="education" class="bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.25em] text-red-900">
            [ RIWAYAT ]
          </span>
          <h2 class="font-heading mt-3 text-3xl font-extrabold uppercase tracking-tight text-slate-950 sm:text-4xl">
            Pendidikan &amp; Pengalaman
          </h2>
          <p class="mt-4 leading-relaxed text-slate-600">
            Perjalanan pendidikan, pengalaman kepemimpinan, dan kontribusi pengembangan yang membentuk cara saya bekerja.
          </p>
        </div>

        <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-12">
          <!-- ===== Pendidikan ===== -->
          <div>
            <h3 class="flex items-center gap-2.5 font-heading text-lg font-bold text-slate-950">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-100 text-red-900">
                <i data-lucide="graduation-cap" class="h-5 w-5"></i>
              </span>
              Pendidikan
            </h3>
            <div class="relative mt-6 space-y-8 border-l-2 border-stone-200 pl-6">
              <% portfolio.education.forEach((edu) => { %>
                <div class="relative">
                  <span class="absolute -left-[30px] top-1.5 h-4 w-4 rounded-full border-2 border-red-900 bg-white"></span>
                  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h4 class="font-heading font-bold text-slate-950"><%= edu.school %></h4>
                      <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-red-900"><%= edu.period %></span>
                    </div>
                    <p class="mt-1 text-sm font-semibold text-amber-600"><%= edu.major %></p>
                    <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= edu.desc %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- ===== Pengalaman & Leadership ===== -->
          <div>
            <h3 class="flex items-center gap-2.5 font-heading text-lg font-bold text-slate-950">
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <i data-lucide="users" class="h-5 w-5"></i>
              </span>
              Pengalaman &amp; Leadership
            </h3>
            <div class="relative mt-6 space-y-8 border-l-2 border-stone-200 pl-6">
              <% portfolio.experiences.forEach((exp) => { %>
                <div class="relative">
                  <span class="absolute -left-[30px] top-1.5 h-4 w-4 rounded-full border-2 border-amber-500 bg-white"></span>
                  <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h4 class="font-heading font-bold text-slate-950"><%= exp.role %></h4>
                      <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-600"><%= exp.period %></span>
                    </div>
                    <p class="mt-1 text-sm font-semibold text-slate-700"><%= exp.org %></p>
                    <% if (exp.team || exp.gitWorkflow) { %>
                    <div class="mt-3 flex flex-wrap gap-2">
                      <% if (exp.team) { %>
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-stone-200 bg-white px-2.5 py-1 text-[11px] font-medium text-slate-600">
                        <i data-lucide="users" class="h-3 w-3"></i>
                        Tim <%= exp.team %>
                      </span>
                      <% } %>
                      <% if (exp.gitWorkflow) { %>
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-medium text-emerald-700">
                        <i data-lucide="git-branch" class="h-3 w-3"></i>
                        <%= exp.gitWorkflow %>
                      </span>
                      <% } %>
                    </div>
                    <% } %>
                    <ul class="mt-3 space-y-1.5">
                      <% exp.responsibilities.forEach((r) => { %>
                        <li class="flex items-start gap-2 text-sm leading-relaxed text-slate-600">
                          <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-amber-500"></i>
                          <span><%= r %></span>
                        </li>
                      <% }) %>
                    </ul>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FEATURED PROJECTS — Horizontal Scroll Section
         Desktop : section di-pin (GSAP ScrollTrigger); kartu proyek
                   bergerak horizontal (translateX) mengikuti scroll.
         Mobile  : native horizontal swipe (overflow-x + scroll-snap),
                   tanpa pinning agar tidak terjadi scroll-jacking.
    ============================================================ -->
    <section id="projects" class="relative bg-white">
      <div class="projects-pin relative w-full">
        <!-- ===== Header: badge + judul + filter kategori ===== -->
        <div class="relative z-10 mx-auto w-full max-w-6xl shrink-0 px-4 pt-20 sm:px-6 md:pt-24">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
            <div class="max-w-2xl">
              <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.25em] text-red-900">
                [ PORTFOLIO ]
              </span>
              <h2 class="font-heading mt-3 text-3xl font-extrabold uppercase tracking-tight text-slate-950 sm:text-4xl">
                Proyek Pilihan
              </h2>
              <p class="mt-4 leading-relaxed text-slate-600">
                Beberapa proyek unggulan yang saya kerjakan — dari pengembangan web hingga produksi video.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <!-- Badge Featured Projects -->
              <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-950/10 bg-slate-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-slate-700">
                <i data-lucide="sparkles" class="h-3.5 w-3.5 text-amber-500"></i>
                Featured Projects
              </span>

              <!-- Filter kategori pill-button -->
              <div id="project-filters" class="flex flex-wrap gap-2">
                <button
                  type="button"
                  data-filter="all"
                  aria-pressed="true"
                  class="cursor-pointer rounded-full border border-red-900 bg-red-900 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all duration-200"
                >
                  Semua
                </button>
                <button
                  type="button"
                  data-filter="web"
                  aria-pressed="false"
                  class="cursor-pointer rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-600 transition-all duration-200 hover:border-red-500 hover:text-red-900"
                >
                  Web App
                </button>
                <button
                  type="button"
                  data-filter="video"
                  aria-pressed="false"
                  class="cursor-pointer rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-600 transition-all duration-200 hover:border-red-500 hover:text-red-900"
                >
                  Video &amp; Film
                </button>
              </div>

              <!-- Navigasi panah kiri/kanan kartu proyek -->
              <div class="flex items-center gap-2">
                <button
                  id="projects-prev"
                  type="button"
                  aria-label="Proyek sebelumnya"
                  disabled
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-950/10 bg-slate-950 text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:scale-105 hover:bg-red-900 hover:shadow-lg hover:shadow-red-900/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-900/40 disabled:cursor-not-allowed disabled:opacity-35 disabled:shadow-none disabled:hover:translate-y-0 disabled:hover:scale-100 disabled:hover:bg-slate-950"
                >
                  <i data-lucide="chevron-left" class="h-4 w-4"></i>
                </button>
                <button
                  id="projects-next"
                  type="button"
                  aria-label="Proyek berikutnya"
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-950/10 bg-slate-950 text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:scale-105 hover:bg-red-900 hover:shadow-lg hover:shadow-red-900/30 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-900/40 disabled:cursor-not-allowed disabled:opacity-35 disabled:shadow-none disabled:hover:translate-y-0 disabled:hover:scale-100 disabled:hover:bg-slate-950"
                >
                  <i data-lucide="chevron-right" class="h-4 w-4"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ===== Track horizontal kartu proyek ===== -->
        <div class="relative z-10 mt-8 flex min-h-0 w-full flex-1 items-stretch md:mt-10">
          <div class="relative mx-auto h-full w-full max-w-6xl px-4 sm:px-6">
            <div id="projects-viewport" class="projects-viewport h-full w-full">
              <div id="projects-track" class="projects-track flex h-full w-max items-stretch gap-5 md:gap-8">
                <% if (projects.length > 0) { %>
                  <% projects.forEach((project, idx) => { %>
                    <article class="project-card-wrap group/card relative flex w-[78vw] shrink-0 sm:w-[380px] md:w-[400px] lg:w-[440px]">
                      <div class="project-card flex h-full w-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-red-200 hover:shadow-xl hover:shadow-red-900/5 will-change-transform">
                        <!-- Foto -->
                        <div class="relative h-44 w-full shrink-0 overflow-hidden border-b border-stone-100 bg-slate-100 md:h-48">
                          <% if (project.image) { %>
                            <img
                              src="/images/<%= project.image %>"
                              alt="<%= project.title %>"
                              loading="lazy"
                              class="h-full w-full object-cover transition-transform duration-500 group-hover/card:scale-105"
                            />
                          <% } else { %>
                            <span class="flex h-full w-full items-center justify-center text-xs font-medium tracking-wide text-slate-400">[ Slot Foto Proyek ]</span>
                          <% } %>
                          <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-red-900 shadow-sm">
                            <%= project.project_type === 'video' ? '🎬 Sutradara & Editor Utama' : '💻 Web App' %>
                          </span>
                          <span class="absolute right-4 top-4 inline-flex items-center rounded-full bg-slate-950/80 px-2.5 py-1 font-heading text-[10px] font-bold text-white shadow-sm">
                            <%= String(idx + 1).padStart(2, '0') %>
                          </span>
                          <% if (project.project_type === 'video' && project.duration) { %>
                            <span class="absolute bottom-3 right-3 flex items-center gap-1 rounded-md bg-slate-950/85 px-2 py-1 text-[11px] font-semibold text-white">
                              <i data-lucide="play" class="h-3 w-3"></i>
                              <%= project.duration %>
                            </span>
                          <% } %>
                        </div>

                        <!-- Body -->
                        <div class="flex flex-1 flex-col p-5 md:p-6">
                          <h3 class="font-heading text-lg font-extrabold tracking-tight text-slate-950 md:text-xl"><%= project.title %></h3>
                          <p class="mt-1.5 text-[11px] font-bold uppercase tracking-wider text-red-900/80"><%= project.role %></p>
                          <p class="mt-3 line-clamp-3 min-h-0 flex-1 text-sm leading-relaxed text-slate-500"><%= project.description %></p>
                          <div class="mt-4 flex shrink-0 flex-wrap gap-1.5">
                            <% project.tech_stack.split(',').map(t => t.trim()).filter(Boolean).forEach((tech) => { %>
                              <span class="rounded-md bg-stone-100 px-2 py-1 text-[11px] font-medium text-stone-600"><%= tech %></span>
                            <% }) %>
                          </div>
                          <div class="mt-5 shrink-0 border-t border-stone-100 pt-4">
                            <% if (project.project_type === 'video') { %>
                              <% if (project.link_url) { %>
                                <div class="grid grid-cols-2 gap-2">
                                  <a
                                    href="<%= project.link_url %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md"
                                  >
                                    <i data-lucide="external-link" class="h-3.5 w-3.5"></i>
                                    Lihat Instagram
                                  </a>
                                  <button
                                    type="button"
                                    data-project-video="<%= project.id %>"
                                    title="<%= project.video_url ? 'Tonton video' : 'Video belum tersedia' %>"
                                    class="<%= project.video_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-red-900 hover:shadow-none' %> inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-red-900 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md"
                                  >
                                    <i data-lucide="play" class="h-3.5 w-3.5"></i>
                                    <%= project.video_url ? 'Tonton Video' : 'Video Segera Hadir' %>
                                  </button>
                                </div>
                              <% } else { %>
                                <button
                                  type="button"
                                  data-project-video="<%= project.id %>"
                                  title="<%= project.video_url ? 'Tonton video' : 'Video belum tersedia' %>"
                                  class="<%= project.video_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-red-900 hover:shadow-none' %> inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-red-900 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md"
                                >
                                  <i data-lucide="play" class="h-3.5 w-3.5"></i>
                                  <%= project.video_url ? 'Tonton Video' : 'Video Segera Hadir' %>
                                </button>
                              <% } %>
                            <% } else { %>
                              <div class="grid grid-cols-2 gap-2">
                                <a
                                  href="<%= project.github_url || '#' %>"
                                  <% if (!project.github_url) { %>onclick="return false;"<% } %>
                                  title="<%= project.github_url ? 'Buka repository GitHub' : 'Repository belum tersedia' %>"
                                  class="<%= project.github_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-slate-950 hover:shadow-none' %> inline-flex items-center justify-center gap-1.5 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md"
                                >
                                  <i data-lucide="github" class="h-3.5 w-3.5"></i>
                                  GitHub
                                </a>
                                <a
                                  href="<%= project.link_url || '#' %>"
                                  <% if (project.link_url) { %>target="_blank" rel="noopener noreferrer"<% } %>
                                  <% if (!project.link_url) { %>onclick="return false;"<% } %>
                                  title="<%= project.link_url ? 'Buka demo langsung' : 'Demo belum tersedia' %>"
                                  class="<%= project.link_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-red-900 hover:shadow-none' %> inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-900 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md"
                                >
                                  <i data-lucide="external-link" class="h-3.5 w-3.5"></i>
                                  Live Demo
                                </a>
                              </div>
                            <% } %>
                            <button
                              type="button"
                              data-project-detail="<%= project.id %>"
                              class="group/detail mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-stone-200 bg-white px-3 py-2 text-xs font-bold uppercase tracking-wide text-slate-700 transition-all duration-200 hover:border-red-300 hover:bg-red-50 hover:text-red-900"
                            >
                              Lihat Detail Proyek
                              <i data-lucide="book-open" class="h-3.5 w-3.5 transition-transform duration-200 group-hover/detail:translate-x-0.5"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                    </article>
                  <% }) %>
                <% } else { %>
                  <div class="flex w-full max-w-md items-center justify-center gap-3 rounded-2xl border border-dashed border-stone-300 p-10 text-sm text-slate-500">
                    <i data-lucide="folder-open" class="h-6 w-6 shrink-0"></i>
                    <span>Belum ada proyek untuk ditampilkan.</span>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- Fade tepi kiri (isyarat visual konten lanjutan) -->
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-10 bg-gradient-to-r from-white to-transparent sm:w-14"></div>
            <!-- Fade tepi kanan -->
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-10 bg-gradient-to-l from-white to-transparent sm:w-14"></div>
          </div>
        </div>

        <!-- ===== Progress bar + hint "scroll to explore" ===== -->
        <div class="relative z-10 mx-auto mt-8 w-full max-w-6xl shrink-0 px-4 pb-8 sm:px-6 md:mt-10 md:pb-10">
          <div class="flex items-center justify-between gap-4">
            <p id="projects-hint" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
              <span class="md:hidden">Geser untuk lihat lebih banyak</span>
              <span class="hidden md:inline">Scroll to explore</span>
              <i data-lucide="arrow-right" class="h-3.5 w-3.5 animate-pulse"></i>
            </p>
            <!-- Hanya tampil di ≥769px (GSAP aktif): di bawah 769px pakai native swipe -->
            <div class="hidden h-1 w-full max-w-xs flex-1 overflow-hidden rounded-full bg-stone-200 sm:max-w-sm min-[769px]:block">
              <div
                id="projects-progress-bar"
                class="h-full w-full origin-left rounded-full bg-red-900"
                style="transform: scaleX(0)"
              ></div>
            </div>
            <span id="projects-counter" class="hidden font-heading text-xs font-bold text-slate-400 min-[769px]:inline">
              <%= projects.length ? `01 / ${String(projects.length).padStart(2, '0')}` : '—' %>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CONTACT — 2 kolom: typography impactful + quick action cards
    ============================================================ -->
    <section id="contact" class="bg-slate-50/70 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <!-- ===== Kolom kiri: typography impactful ===== -->
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.25em] text-red-900">
              [ KONTAK ]
            </span>
            <h2 class="font-heading mt-4 text-4xl font-extrabold uppercase leading-[1.05] tracking-tight text-slate-950 sm:text-5xl">
              Mari<br />Berkolaborasi
            </h2>
            <p class="font-hand mt-3 text-2xl uppercase text-red-700 sm:text-3xl">Let's work together</p>
            <p class="mt-6 max-w-md leading-relaxed text-slate-600">
              Punya ide, tawaran kolaborasi, atau lowongan PKL? Saya terbuka untuk kerja sama — hubungi langsung lewat email atau WhatsApp, dan saya akan segera merespons.
            </p>
            <div class="mt-8 flex items-center gap-2 text-sm font-medium text-slate-400">
              <i data-lucide="map-pin" class="h-4 w-4"></i>
              <span>Indonesia · Siap kerja jarak jauh (remote)</span>
            </div>
          </div>

          <!-- ===== Kolom kanan: quick action cards ===== -->
          <div class="space-y-5">
            <!-- Kartu Email -->
            <a
              href="mailto:<%= portfolio.contacts.email %>"
              class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:border-red-500 hover:shadow-md"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-900 transition-colors duration-300 group-hover:bg-red-900 group-hover:text-white">
                <i data-lucide="mail" class="h-5 w-5"></i>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Email</span>
                <span class="mt-0.5 block truncate text-sm font-semibold text-slate-900"><%= portfolio.contacts.email %></span>
              </span>
              <i data-lucide="arrow-up-right" class="h-5 w-5 shrink-0 text-stone-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-red-900"></i>
            </a>

            <!-- Kartu WhatsApp / Phone -->
            <a
              href="https://wa.me/6283871267899"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:border-emerald-500 hover:shadow-md"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 transition-colors duration-300 group-hover:bg-emerald-500 group-hover:text-white">
                <i data-lucide="phone" class="h-5 w-5"></i>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">WhatsApp / Phone</span>
                <span class="mt-0.5 block text-sm font-semibold text-slate-900">+62 838-7126-7899 / +62 851-8335-3499</span>
              </span>
              <i data-lucide="arrow-up-right" class="h-5 w-5 shrink-0 text-stone-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-emerald-500"></i>
            </a>

            <!-- Kartu GitHub -->
            <a
              href="<%= portfolio.contacts.github %>"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:border-slate-950 hover:shadow-md"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-950 text-white transition-colors duration-300 group-hover:bg-slate-800">
                <i data-lucide="github" class="h-5 w-5"></i>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">GitHub</span>
                <span class="mt-0.5 block truncate text-sm font-semibold text-slate-900">github.com/Bim-bim08</span>
              </span>
              <i data-lucide="arrow-up-right" class="h-5 w-5 shrink-0 text-stone-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-slate-950"></i>
            </a>

            <!-- Kartu Sekolah -->
            <a
              href="#about"
              class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:border-amber-500 hover:shadow-md"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 transition-colors duration-300 group-hover:bg-amber-500 group-hover:text-white">
                <i data-lucide="graduation-cap" class="h-5 w-5"></i>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Sekolah</span>
                <span class="mt-0.5 block truncate text-sm font-semibold text-slate-900"><%= portfolio.contacts.school %></span>
              </span>
              <i data-lucide="arrow-up-right" class="h-5 w-5 shrink-0 text-stone-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-amber-500"></i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ============================================================
       MODAL — Case Study / Detail Proyek
       Menampilkan Role, Masalah, Solusi, Fitur Utama, & Tech Stack
       saat tombol "Lihat Detail Proyek" pada kartu diklik.
  ============================================================ -->
  <div
    id="project-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-modal-title"
    class="fixed inset-0 z-[60] hidden items-center justify-center p-4"
  >
    <div id="project-modal-backdrop" class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm"></div>

    <div id="project-modal-panel" class="relative z-10 max-h-[85vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white shadow-2xl">
      <!-- Cover -->
      <div class="relative h-44 w-full shrink-0 overflow-hidden bg-slate-100 md:h-56">
        <img id="project-modal-img" src="" alt="" class="h-full w-full object-cover" />
        <span
          id="project-modal-type"
          class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-red-900 shadow-sm"
        ></span>
        <button
          id="project-modal-close"
          type="button"
          aria-label="Tutup detail proyek"
          class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-slate-950/70 text-white shadow-sm transition-all duration-200 hover:scale-105 hover:bg-red-900"
        >
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>

      <!-- Gallery Thumbnails -->
      <div
        id="project-modal-gallery"
        class="hidden w-full shrink-0 overflow-x-auto border-b border-stone-100 bg-slate-50 px-4 py-2.5"
      >
        <div id="project-modal-gallery-strip" class="flex gap-2"></div>
      </div>

      <div class="p-6 md:p-8">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.25em] text-red-900">
            [ Case Study ]
          </span>
          <span id="project-modal-duration" class="hidden inline-flex items-center gap-1 rounded-full bg-slate-950/85 px-2.5 py-1 text-[11px] font-semibold text-white">
            <i data-lucide="play" class="h-3 w-3"></i>
          </span>
        </div>
        <h3 id="project-modal-title" class="font-heading mt-3 text-2xl font-extrabold tracking-tight text-slate-950 md:text-3xl"></h3>

        <!-- Role -->
        <div class="mt-6">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Role</p>
          <p id="project-modal-role" class="mt-1.5 text-sm font-semibold text-slate-700"></p>
        </div>

        <!-- Masalah -->
        <div class="mt-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Masalah</p>
          <p id="project-modal-problem" class="mt-1.5 text-sm leading-relaxed text-slate-600"></p>
        </div>

        <!-- Solusi -->
        <div class="mt-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Solusi</p>
          <p id="project-modal-solution" class="mt-1.5 text-sm leading-relaxed text-slate-600"></p>
        </div>

        <!-- Fitur Utama -->
        <div class="mt-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Fitur Utama</p>
          <ul id="project-modal-features" class="mt-2 grid gap-2 sm:grid-cols-2"></ul>
        </div>

        <!-- Metrik Proyek -->
        <div id="project-modal-metrics-wrap" class="mt-5">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Metrik Proyek</p>
          <div id="project-modal-metrics" class="mt-2 grid gap-2 sm:grid-cols-2"></div>
        </div>

        <!-- Tech Stack / Peralatan -->
        <div class="mt-5">
          <p id="project-modal-tech-label" class="text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Tech Stack</p>
          <div id="project-modal-tech" class="mt-2 flex flex-wrap gap-1.5"></div>
        </div>

        <!-- Aksi -->
        <div class="mt-7 border-t border-stone-100 pt-5">
          <div id="project-modal-web-actions" class="grid grid-cols-2 gap-3">
            <a
              id="project-modal-github"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md"
            >
              <i data-lucide="github" class="h-4 w-4"></i>
              GitHub Repo
            </a>
            <a
              id="project-modal-demo"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-red-900 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md"
            >
              <i data-lucide="external-link" class="h-4 w-4"></i>
              Live Demo
            </a>
          </div>
          <button
            id="project-modal-watch"
            type="button"
            class="hidden w-full items-center justify-center gap-2 rounded-xl bg-red-900 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md"
          >
            <i data-lucide="play" class="h-4 w-4"></i>
            Tonton Video
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIDEO LIGHTBOX — Pemutar karya video proyek
  ============================================================ -->
  <div
    id="video-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Pemutar video proyek"
    class="fixed inset-0 z-[70] hidden items-center justify-center p-4"
  >
    <div id="video-modal-backdrop" class="absolute inset-0 bg-slate-950/75 backdrop-blur-sm"></div>

    <div class="relative z-10 w-full max-w-3xl">
      <div class="mb-3 flex items-center justify-between">
        <p class="font-heading text-sm font-bold uppercase tracking-[0.2em] text-white">Karya Video</p>
        <button
          id="video-modal-close"
          type="button"
          aria-label="Tutup pemutar video"
          class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition-all duration-200 hover:scale-105 hover:bg-red-900"
        >
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>
      <div class="aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-2xl">
        <iframe
          id="video-modal-frame"
          class="h-full w-full"
          src=""
          title="Pemutar video proyek"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>
