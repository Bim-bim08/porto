<%- include('partials/head') %>
<%- include('partials/header') %>

  <main>
    <!-- ============================================================
         FLASH MESSAGE (feedback form kontak)
    ============================================================ -->
    <% if (flash.status) { %>
      <div
        id="flash-toast"
        class="fixed inset-x-0 top-20 z-40 mx-auto w-fit max-w-md px-4 transition-all duration-300"
      >
        <div class="<%= flash.status === 'success'
            ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
            : 'bg-red-50 border-red-200 text-red-800' %>
          flex items-center gap-3 rounded-xl border px-4 py-3 shadow-lg">
          <i data-lucide="<%= flash.status === 'success' ? 'check-circle-2' : 'alert-circle' %>" class="h-5 w-5 shrink-0"></i>
          <p class="text-sm font-medium"><%= flash.message %></p>
        </div>
      </div>
    <% } %>

    <!-- ============================================================
         HERO — Spider-Verse Modern (Iron Spider)
    ============================================================ -->
    <section id="home" class="relative overflow-hidden bg-white">
      <!-- Jaring laba-laba sangat halus (emas muda di atas putih) — expand dari tengah -->
      <div aria-hidden="true" class="web-pattern web-pattern-anim pointer-events-none absolute inset-0 opacity-[0.07]"></div>

      <!-- Akses web sudut kanan-atas -->
      <svg aria-hidden="true" viewBox="0 0 200 200" fill="none" class="corner-web pointer-events-none absolute -top-10 -right-10 h-64 w-64 text-amber-500/25">
        <g stroke="currentColor" stroke-width="1.5">
          <circle cx="200" cy="0" r="40" />
          <circle cx="200" cy="0" r="80" />
          <circle cx="200" cy="0" r="120" />
          <circle cx="200" cy="0" r="160" />
          <path d="M200 0v200M200 0H0" />
          <path d="M200 0L100 100M200 0L59 59" />
        </g>
      </svg>

      <!-- Akses web sudut kiri-bawah -->
      <svg aria-hidden="true" viewBox="0 0 200 200" fill="none" class="corner-web corner-web-late pointer-events-none absolute -bottom-12 -left-12 h-72 w-72 text-amber-500/20">
        <g stroke="currentColor" stroke-width="1.5">
          <circle cx="0" cy="200" r="40" />
          <circle cx="0" cy="200" r="80" />
          <circle cx="0" cy="200" r="120" />
          <circle cx="0" cy="200" r="160" />
          <path d="M0 200V0M0 200H200" />
          <path d="M0 200L100 100M0 200L141 59" />
        </g>
      </svg>

      <!-- ===== Dekorasi Spider-Verse (di sekeliling hero, minimalis) ===== -->
      <!-- Peter Parker — bergelantung dari tali jaring (kiri atas) -->
      <div class="pointer-events-none absolute top-0 left-6 md:left-[15%]">
        <div class="web-drop flex w-fit flex-col items-center">
          <div class="web-swing flex w-fit flex-col items-center">
            <!-- Tali jaring laba-laba: dari batas atas hero, mendarat tepat di tangan Peter (x≈62% gambar) -->
            <div
              class="relative left-[12%] h-28 w-[3px] bg-gradient-to-b from-amber-400/30 via-slate-100 to-white shadow-[0_0_8px_rgba(255,255,255,0.8)] drop-shadow-[0_0_4px_rgba(251,191,36,0.5)] md:h-32"
            ></div>
            <img
              src="/images/peter.png"
              alt="Peter Parker"
              class="pointer-events-auto w-[120px] h-auto object-contain drop-shadow-lg transition-transform duration-300 hover:scale-110 md:w-40"
            />
            <span class="font-heading mt-2 text-[10px] font-bold uppercase tracking-[0.2em] text-red-900">Peter Parker</span>
          </div>
        </div>
      </div>

      <!-- Miles Morales — bergelantung dari tali jaring (kanan atas) -->
      <div class="pointer-events-none absolute top-0 right-6 md:right-[15%]">
        <div class="web-drop web-drop-delay flex w-fit flex-col items-center">
          <div class="web-swing web-swing-slower flex w-fit flex-col items-center">
            <!-- Tali jaring laba-laba: dari batas atas hero, mendarat tepat di tangan Miles (x≈25% gambar) -->
            <div
              class="relative -left-[24.6%] h-32 w-[3px] bg-gradient-to-b from-amber-400/30 via-slate-100 to-white shadow-[0_0_8px_rgba(255,255,255,0.8)] drop-shadow-[0_0_4px_rgba(251,191,36,0.5)] md:h-36"
            ></div>
            <img
              src="/images/miles.png"
              alt="Miles Morales"
              class="pointer-events-auto w-[120px] h-auto object-contain drop-shadow-lg transition-transform duration-300 hover:scale-110 md:w-40"
            />
            <span class="font-heading mt-2 text-[10px] font-bold uppercase tracking-[0.2em] text-slate-950">Miles Morales</span>
          </div>
        </div>
      </div>

      <!-- Gwen Stacy (kiri bawah dekat CTA) -->
      <div class="fade-up fade-up-gwen pointer-events-none absolute bottom-24 left-6 hidden md:block lg:left-1/4">
        <div class="animate-float flex flex-col items-center gap-2.5">
          <img
            src="/images/gwen.png"
            alt="Gwen Stacy"
            class="pointer-events-auto w-20 h-auto object-contain drop-shadow-lg transition-transform duration-300 hover:scale-110 md:w-28"
          />
        </div>
      </div>

      <!-- ===== Konten utama hero ===== -->
      <div class="relative mx-auto max-w-6xl px-4 pb-24 pt-32 text-center sm:px-6 sm:pt-36">
        <div class="relative mx-auto mt-4 max-w-sm sm:max-w-md">
          <!-- Teks script 'hi, i'm' di atas kiri foto, sedikit turun dari posisi awal -->
          <p class="font-hand absolute -top-4 -left-2 z-30 -rotate-6 text-5xl text-red-800 sm:-top-6 sm:-left-10 sm:text-6xl">
            <span class="mask-reveal inline-block">
              <span class="mask-reveal-inner inline-block">hi, i'm</span>
            </span>
          </p>

          <!-- Foto profil + efek Spider-Sense (insting) dalam satu kontainer -->
          <div class="photo-rise relative inline-block w-full">
            <img
              src="/images/profile-hero.png"
              alt="Bima Respati"
              class="block h-auto w-full object-contain drop-shadow-2xl"
              style="mask-image: linear-gradient(to bottom, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);"
            />
            <!-- Spider-Sense: pusat burst tepat di kepala (x≈48%, y≈34% gambar) -->
            <div class="electric-burst pointer-events-none absolute left-[48%] top-[34%] z-20 w-[280px] -translate-x-1/2 -translate-y-1/2 sm:w-[380px]">
              <img
                src="/images/insting.png"
                alt=""
                aria-hidden="true"
                class="h-auto w-full object-contain drop-shadow-[0_0_6px_rgba(255,255,255,0.6)] animate-insting-pulse"
              />
            </div>
          </div>
        </div>

        <!-- Nama raksasa (overlap tipis di bawah foto) -->
        <h1 class="font-heading relative z-10 -mt-8 text-5xl font-extrabold leading-[0.95] tracking-tighter text-slate-950 sm:-mt-10 sm:text-7xl lg:text-8xl">
          <span class="mask-reveal block">
            <span class="mask-reveal-inner mask-reveal-later block"><%= portfolio.name %></span>
          </span>
        </h1>

        <!-- Garis aksen emas -->
        <span aria-hidden="true" class="line-grow mx-auto mt-7 block h-px w-16 bg-amber-500/70"></span>

        <p class="fade-up mt-6 text-xl font-semibold text-slate-900 sm:text-2xl">
          <%= portfolio.role %>
        </p>

        <p class="fade-up fade-up-later mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          <%= portfolio.tagline %>
        </p>

        <!-- CTA -->
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="#projects"
            class="cta-slide-left inline-flex items-center gap-2 rounded-full bg-red-900 px-8 py-3.5 text-sm font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-950 hover:shadow-xl"
          >
            Lihat Proyek
            <i data-lucide="arrow-down" class="h-4 w-4"></i>
          </a>
          <a
            href="#contact"
            class="cta-slide-right inline-flex items-center gap-2 rounded-full border border-slate-950 bg-white px-8 py-3.5 text-sm font-semibold text-slate-950 transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-950 hover:text-white"
          >
            Hubungi Saya
            <i data-lucide="mail" class="h-4 w-4"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         ABOUT — Tentang Saya
    ============================================================ -->
    <section id="about" class="bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-amber-600">Tentang Saya</p>
          <h2 class="font-heading mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">
            Membangun dengan logika, bercerita lewat visual
          </h2>
          <div class="mt-6 space-y-4 leading-relaxed text-slate-600">
            <% portfolio.about.forEach((paragraph) => { %>
              <p><%= paragraph %></p>
            <% }) %>
          </div>
        </div>

        <!-- Highlight singkat -->
        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          <% const highlights = [
            { icon: 'braces',       title: 'Full-Stack & Backend', desc: 'Web app berlogika kuat dengan Node.js, Express, dan SQL.' },
            { icon: 'clapperboard', title: 'Produksi Multimedia',  desc: 'Sutradara & editor video dengan color grading N-Log.' },
            { icon: 'users',        title: 'Leadership',           desc: 'Berpengalaman memimpin pengerjaan proyek web & video.' },
          ]; %>
          <% highlights.forEach((h) => { %>
            <div class="rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-100 text-red-900">
                <i data-lucide="<%= h.icon %>" class="h-5 w-5"></i>
              </div>
              <h3 class="font-heading mt-4 font-bold text-slate-950"><%= h.title %></h3>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-500"><%= h.desc %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SKILLS & TOOLS
    ============================================================ -->
    <section id="skills" class="bg-slate-50/70 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-amber-600">Skills & Tools</p>
          <h2 class="font-heading mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">Teknologi yang saya gunakan</h2>
          <p class="mt-4 leading-relaxed text-slate-600">
            Kumpulan bahasa pemrograman, framework, dan tools yang saya kuasai untuk membangun web dan memproduksi konten.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <% portfolio.skills.forEach((group) => { %>
            <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <i data-lucide="<%= group.icon %>" class="h-5 w-5"></i>
              </div>
              <h3 class="font-heading mt-4 font-bold text-slate-950"><%= group.category %></h3>
              <ul class="mt-3 space-y-2">
                <% group.items.forEach((item) => { %>
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-amber-600"></i>
                    <span><%= item %></span>
                  </li>
                <% }) %>
              </ul>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FEATURED PROJECTS — Asymmetric Grid & Highlight Cards
    ============================================================ -->
    <section id="projects" class="bg-white py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <!-- ===== Header: badge + judul + filter kategori ===== -->
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.25em] text-red-900">
              [ PORTFOLIO ]
            </span>
            <h2 class="font-heading mt-3 text-3xl font-extrabold uppercase tracking-tight text-slate-950 sm:text-4xl">
              Proyek Pilihan
            </h2>
            <p class="mt-4 leading-relaxed text-slate-600">
              Beberapa proyek unggulan yang saya kerjakan — dari pengembangan web hingga produksi video.
            </p>

            <!-- Filter kategori pill-button -->
            <div id="project-filters" class="mt-6 flex flex-wrap gap-2">
              <button
                type="button"
                data-filter="all"
                aria-pressed="true"
                class="cursor-pointer rounded-full border border-red-900 bg-red-900 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-sm transition-all duration-200"
              >
                Semua
              </button>
              <button
                type="button"
                data-filter="web"
                aria-pressed="false"
                class="cursor-pointer rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-600 transition-all duration-200 hover:border-red-500 hover:text-red-900"
              >
                Web App
              </button>
              <button
                type="button"
                data-filter="video"
                aria-pressed="false"
                class="cursor-pointer rounded-full border border-stone-300 bg-white px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-600 transition-all duration-200 hover:border-red-500 hover:text-red-900"
              >
                Video &amp; Film
              </button>
            </div>
          </div>

          <% if (!dbAvailable) { %>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700">
              <i data-lucide="database" class="h-3.5 w-3.5"></i>
              Mode demo — data dummy
            </span>
          <% } %>
        </div>

        <!-- ===== Grid asimetris: 1 kartu utama (kiri) + 2 kartu pendukung (kanan) ===== -->
        <div class="mt-12 grid items-start gap-6 lg:grid-cols-5">
          <!-- Kolom kiri: proyek utama / large card -->
          <div id="main-project-slot" class="lg:col-span-3">
            <% if (projects.length > 0) { %>
              <% const main = projects[0]; %>
              <article class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6">
                <!-- Slot foto utama (16:9) -->
                <div class="relative flex aspect-[16/9] w-full items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
                  <% if (main.image) { %>
                    <img
                      src="/images/<%= main.image %>"
                      alt="<%= main.title %>"
                      class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                    />
                  <% } else { %>
                    <span class="text-sm font-medium tracking-wide text-slate-400">[ Slot Foto Proyek Utama ]</span>
                  <% } %>
                  <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-red-900 shadow-sm">
                    <%= main.project_type === 'video' ? '🎬 Video & Film' : '💻 Web App' %>
                  </span>
                </div>

                <div class="flex flex-1 flex-col px-1 pb-1 pt-5">
                  <h3 class="font-heading text-xl font-extrabold tracking-tight text-slate-950 sm:text-2xl">
                    <%= main.title %>
                  </h3>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500 sm:text-base">
                    <%= main.description %>
                  </p>

                  <!-- Tag tech stack -->
                  <div class="mt-5 flex flex-wrap gap-2">
                    <% main.tech_stack.split(',').map(t => t.trim()).filter(Boolean).forEach((tech) => { %>
                      <span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700 transition-colors duration-200 hover:bg-amber-50 hover:text-amber-700"><%= tech %></span>
                    <% }) %>
                  </div>

                  <!-- Link aksi -->
                  <div class="mt-6 flex items-center justify-end border-t border-stone-100 pt-4">
                    <a
                      href="<%= main.link_url || '#' %>"
                      <% if (!main.link_url) { %>onclick="return false;"<% } %>
                      class="group/link inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-red-900 transition-all duration-200 hover:gap-3"
                    >
                      Lihat Detail Proyek
                      <i data-lucide="arrow-right" class="h-4 w-4 transition-transform duration-200 group-hover/link:translate-x-0.5"></i>
                    </a>
                  </div>
                </div>
              </article>
            <% } else { %>
              <div class="rounded-2xl border border-dashed border-stone-300 p-12 text-center text-slate-500">
                <i data-lucide="folder-open" class="mx-auto h-8 w-8"></i>
                <p class="mt-3 text-sm">Belum ada proyek untuk ditampilkan.</p>
              </div>
            <% } %>
          </div>

          <!-- Kolom kanan: 2 proyek pendukung / stacked cards -->
          <div id="stacked-projects-slot" class="space-y-6 lg:col-span-2">
            <% projects.slice(1, 3).forEach((project) => { %>
              <article class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
                <!-- Slot foto banner horizontal -->
                <div class="relative flex h-36 w-full items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
                  <% if (project.image) { %>
                    <img
                      src="/images/<%= project.image %>"
                      alt="<%= project.title %>"
                      class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
                    />
                  <% } else { %>
                    <span class="text-xs font-medium tracking-wide text-slate-400">[ Slot Foto Proyek ]</span>
                  <% } %>
                </div>

                <div class="flex flex-1 flex-col px-1 pb-1 pt-4">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-heading text-base font-bold tracking-tight text-slate-950"><%= project.title %></h3>
                    <span class="shrink-0 rounded-full bg-red-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-red-900">
                      <%= project.project_type === 'video' ? '🎬 Video' : '💻 Web' %>
                    </span>
                  </div>
                  <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-slate-500"><%= project.description %></p>
                  <div class="mt-4 flex flex-wrap gap-1.5 border-t border-stone-100 pt-3">
                    <% project.tech_stack.split(',').map(t => t.trim()).filter(Boolean).forEach((tech) => { %>
                      <span class="rounded-md bg-stone-100 px-2 py-0.5 text-[11px] font-medium text-stone-600"><%= tech %></span>
                    <% }) %>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         CONTACT — 2 kolom: typography impactful + quick action cards
    ============================================================ -->
    <section id="contact" class="bg-slate-50/70 py-20 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <!-- ===== Kolom kiri: typography impactful ===== -->
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.25em] text-red-900">
              [ KONTAK ]
            </span>
            <h2 class="font-heading mt-4 text-4xl font-extrabold uppercase leading-[1.05] tracking-tight text-slate-950 sm:text-5xl">
              Mari<br />Berkolaborasi
            </h2>
            <p class="font-hand mt-3 text-2xl uppercase text-red-700 sm:text-3xl">Let's work together</p>
            <p class="mt-6 max-w-md leading-relaxed text-slate-600">
              Punya ide, tawaran kolaborasi, atau lowongan PKL? Saya terbuka untuk kerja sama — hubungi langsung lewat email atau WhatsApp, dan saya akan segera merespons.
            </p>
            <div class="mt-8 flex items-center gap-2 text-sm font-medium text-slate-400">
              <i data-lucide="map-pin" class="h-4 w-4"></i>
              <span>Indonesia · Siap kerja jarak jauh (remote)</span>
            </div>
          </div>

          <!-- ===== Kolom kanan: quick action cards ===== -->
          <div class="space-y-5">
            <!-- Kartu Email -->
            <a
              href="mailto:bimarespati@email.com"
              class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:border-red-500 hover:shadow-md"
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-900 transition-colors duration-300 group-hover:bg-red-900 group-hover:text-white">
                <i data-lucide="mail" class="h-5 w-5"></i>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11px] font-bold uppercase tracking-[0.2em] text-slate-400">Email</span>
                <span class="mt-0.5 block truncate text-sm font-semibold text-slate-900">bimarespati@email.com</span>
              </span>
              <i data-lucide="arrow-up-right" class="h-5 w-5 shrink-0 text-stone-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-red-900"></i>
            </a>

            <!-- Kartu WhatsApp -->
            <a
              href="https://wa.me/6281234567890"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-300 hover:border-red-500 hover:shadow-md"
            >
