  <!-- ============================================================
       FOOTER
  ============================================================ -->
  <footer class="border-t border-stone-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
      <p class="text-sm text-slate-500">
        © <%= new Date().getFullYear() %> <%= portfolio.name %>. All rights reserved.
      </p>

      <div class="flex items-center gap-3">
        <% portfolio.socials.forEach((s) => { %>
          <a
            href="<%= s.url %>"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="<%= s.label %>"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-200 text-slate-500 transition-all duration-200 hover:-translate-y-0.5 hover:border-amber-500/60 hover:text-red-900"
          >
            <i data-lucide="<%= s.icon %>" class="h-4 w-4"></i>
          </a>
        <% }) %>
      </div>

      <p class="text-xs text-slate-400">
        Dibangun dengan Node.js · Express · EJS · Tailwind CSS
      </p>
    </div>
  </footer>

  <!-- ============================================================
       DATA proyek (JSON) untuk filter kategori
  ============================================================ -->
  <script type="application/json" id="projects-data"><%- JSON.stringify(projects).replace(/<\//g, '<\\/') %></script>

  <!-- ============================================================
       SCRIPT: lucide icons, mobile menu, toast, filter proyek
  ============================================================ -->
  <script>
    // Render ikon Lucide
    lucide.createIcons();

    // Mobile menu toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      const icon = menuToggle.querySelector('i');
      if (mobileMenu.classList.contains('hidden')) {
        icon.setAttribute('data-lucide', 'menu');
      } else {
        icon.setAttribute('data-lucide', 'x');
      }
      lucide.createIcons();
    });

    // Auto-hide flash toast setelah 4 detik
    const toast = document.getElementById('flash-toast');
    if (toast) {
      setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }      // ============================================================
      //  Filter kategori proyek (SEMUA / WEB APP / VIDEO & FILM)
      //  Catatan: daftar class ACTIVE/IDLE di bawah HARUS sinkron
      //  dengan class awal tombol pill di views/index.ejs.
      // ============================================================
    const projectsDataEl = document.getElementById('projects-data');
    const mainProjectSlot = document.getElementById('main-project-slot');
    const stackedProjectsSlot = document.getElementById('stacked-projects-slot');
    const projectFilters = document.getElementById('project-filters');

    if (projectsDataEl && mainProjectSlot && stackedProjectsSlot && projectFilters) {
      const allProjects = JSON.parse(projectsDataEl.textContent);

      const esc = (s) =>
        String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      const techTags = (p, small) =>
        (p.tech_stack || '')
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean)
          .map((t) =>
            small
              ? `<span class="rounded-md bg-stone-100 px-2 py-0.5 text-[11px] font-medium text-stone-600">${esc(t)}</span>`
              : `<span class="rounded-md bg-stone-100 px-2 py-1 text-xs font-medium text-stone-700">${esc(t)}</span>`
          )
          .join('');

      const mainCard = (p) => `
        <article class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg sm:p-6">
          <div class="relative flex aspect-[16/9] w-full items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
            ${p.image ? `<img src="/images/${esc(p.image)}" alt="${esc(p.title)}" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" />` : '<span class="text-sm font-medium tracking-wide text-slate-400">[ Slot Foto Proyek Utama ]</span>'}
            <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-red-900 shadow-sm">${p.project_type === 'video' ? '🎬 Video &amp; Film' : '💻 Web App'}</span>
          </div>
          <div class="flex flex-1 flex-col px-1 pb-1 pt-5">
            <h3 class="font-heading text-xl font-extrabold tracking-tight text-slate-950 sm:text-2xl">${esc(p.title)}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500 sm:text-base">${esc(p.description)}</p>
            <div class="mt-5 flex flex-wrap gap-2">${techTags(p, false)}</div>
            <div class="mt-6 flex items-center justify-end border-t border-stone-100 pt-4">
              <a href="${p.link_url ? esc(p.link_url) : '#'}" ${p.link_url ? '' : 'onclick="return false;"'} class="group/link inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-red-900 transition-all duration-200 hover:gap-3">
                Lihat Detail Proyek
                <i data-lucide="arrow-right" class="h-4 w-4 transition-transform duration-200 group-hover/link:translate-x-0.5"></i>
              </a>
            </div>
          </div>
        </article>`;

      const stackedCard = (p) => `
        <article class="group flex flex-col rounded-2xl border border-stone-200 bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
          <div class="relative flex h-36 w-full items-center justify-center overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
            ${p.image ? `<img src="/images/${esc(p.image)}" alt="${esc(p.title)}" class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" />` : '<span class="text-xs font-medium tracking-wide text-slate-400">[ Slot Foto Proyek ]</span>'}
          </div>
          <div class="flex flex-1 flex-col px-1 pb-1 pt-4">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-heading text-base font-bold tracking-tight text-slate-950">${esc(p.title)}</h3>
              <span class="shrink-0 rounded-full bg-red-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-red-900">${p.project_type === 'video' ? '🎬 Video' : '💻 Web'}</span>
            </div>
            <p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-slate-500">${esc(p.description)}</p>
            <div class="mt-4 flex flex-wrap gap-1.5 border-t border-stone-100 pt-3">${techTags(p, true)}</div>
          </div>
        </article>`;

      const emptyState =
        '<div class="rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-sm text-slate-500">Belum ada proyek di kategori ini.</div>';

      const ACTIVE = ['border-red-900', 'bg-red-900', 'text-white', 'shadow-sm'];
      const IDLE = ['border-stone-300', 'bg-white', 'text-slate-600', 'hover:border-red-500', 'hover:text-red-900'];

      function renderProjects(filter) {
        let list = allProjects;
        if (filter === 'web') list = allProjects.filter((p) => p.project_type === 'web');
        if (filter === 'video') list = allProjects.filter((p) => p.project_type === 'video');

        const main = list[0];
        mainProjectSlot.innerHTML = main ? mainCard(main) : emptyState;
        stackedProjectsSlot.innerHTML = list.slice(1, 3).map(stackedCard).join('');

        if (window.lucide) lucide.createIcons();
      }

      projectFilters.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-filter]');
        if (!btn) return;
        projectFilters.querySelectorAll('[data-filter]').forEach((b) => {
          b.classList.remove(...ACTIVE);
          b.classList.add(...IDLE);
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.remove(...IDLE);
        btn.classList.add(...ACTIVE);
        btn.setAttribute('aria-pressed', 'true');
        renderProjects(btn.dataset.filter);
      });
    }
  </script>
</body>
</html>
