  <!-- ============================================================
       FOOTER
  ============================================================ -->
  <footer class="border-t border-stone-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 sm:flex-row sm:px-6">
      <p class="text-sm text-slate-500">
        © <%= new Date().getFullYear() %> <%= portfolio.name %>. All rights reserved.
      </p>

      <div class="flex items-center gap-3">
        <% portfolio.socials.forEach((s) => { %>
          <a
            href="<%= s.url %>"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="<%= s.label %>"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-200 text-slate-500 transition-all duration-200 hover:-translate-y-0.5 hover:border-amber-500/60 hover:text-red-900"
          >
            <i data-lucide="<%= s.icon %>" class="h-4 w-4"></i>
          </a>
        <% }) %>
      </div>

      <p class="text-xs text-slate-400">
        Dibangun dengan Node.js · Express · EJS · Tailwind CSS
      </p>
    </div>
  </footer>

  <!-- ============================================================
       DATA proyek (JSON) untuk filter kategori
  ============================================================ -->
  <script type="application/json" id="projects-data"><%- JSON.stringify(projects).replace(/<\//g, '<\\/') %></script>

  <!-- ============================================================
       SCRIPT: lucide icons, mobile menu, toast, filter proyek
  ============================================================ -->
  <script>
    // Render ikon Lucide
    lucide.createIcons();

    // Mobile menu toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      const icon = menuToggle.querySelector('i');
      if (mobileMenu.classList.contains('hidden')) {
        icon.setAttribute('data-lucide', 'menu');
      } else {
        icon.setAttribute('data-lucide', 'x');
      }
      lucide.createIcons();
    });

    // Auto-hide flash toast setelah 4 detik
    const toast = document.getElementById('flash-toast');
    if (toast) {
      setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }      // ============================================================
      //  Filter kategori proyek (SEMUA / WEB APP / VIDEO & FILM)
      //  Catatan: daftar class ACTIVE/IDLE di bawah HARUS sinkron
      //  dengan class awal tombol pill di views/index.ejs.
      // ============================================================
    const projectsDataEl = document.getElementById('projects-data');
    const projectsTrack = document.getElementById('projects-track');
    const projectFilters = document.getElementById('project-filters');
    const projectsCounter = document.getElementById('projects-counter');

    if (projectsDataEl && projectsTrack && projectFilters) {
      const allProjects = JSON.parse(projectsDataEl.textContent);

      // Data lengkap proyek untuk modal case study (dipakai global)
      window.__projectsData = allProjects;

      const esc = (s) =>
        String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      const techTags = (p) =>
        (p.tech_stack || '')
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean)
          .map(
            (t) =>
              `<span class="rounded-md bg-stone-100 px-2 py-1 text-[11px] font-medium text-stone-600">${esc(t)}</span>`
          )
          .join('');

      const horizontalCard = (p, idx) => `
        <article class="project-card-wrap group/card relative flex w-[78vw] shrink-0 sm:w-[380px] md:w-[400px] lg:w-[440px]">
          <div class="project-card flex h-full w-full flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-red-200 hover:shadow-xl hover:shadow-red-900/5 will-change-transform">
            <div class="relative h-44 w-full shrink-0 overflow-hidden border-b border-stone-100 bg-slate-100 md:h-48">
              ${p.image ? `<img src="/images/${esc(p.image)}" alt="${esc(p.title)}" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover/card:scale-105" />` : '<span class="flex h-full w-full items-center justify-center text-xs font-medium tracking-wide text-slate-400">[ Slot Foto Proyek ]</span>'}
              <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.15em] text-red-900 shadow-sm">${p.project_type === 'video' ? '🎬 Sutradara & Editor Utama' : '💻 Web App'}</span>
              <span class="absolute right-4 top-4 inline-flex items-center rounded-full bg-slate-950/80 px-2.5 py-1 font-heading text-[10px] font-bold text-white shadow-sm">${String(idx + 1).padStart(2, '0')}</span>
              ${p.project_type === 'video' && p.duration ? `<span class="absolute bottom-3 right-3 flex items-center gap-1 rounded-md bg-slate-950/85 px-2 py-1 text-[11px] font-semibold text-white"><i data-lucide="play" class="h-3 w-3"></i>${esc(p.duration)}</span>` : ''}
            </div>
            <div class="flex flex-1 flex-col p-5 md:p-6">
              <h3 class="font-heading text-lg font-extrabold tracking-tight text-slate-950 md:text-xl">${esc(p.title)}</h3>
              <p class="mt-1.5 text-[11px] font-bold uppercase tracking-wider text-red-900/80">${esc(p.role || '')}</p>
              <p class="mt-3 line-clamp-3 min-h-0 flex-1 text-sm leading-relaxed text-slate-500">${esc(p.description)}</p>
              <div class="mt-4 flex shrink-0 flex-wrap gap-1.5">${techTags(p)}</div>
              <div class="mt-5 shrink-0 border-t border-stone-100 pt-4">
                ${p.project_type === 'video'
                  ? (p.link_url
                      ? `<div class="grid grid-cols-2 gap-2">
                          <a href="${esc(p.link_url)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md">
                            <i data-lucide="external-link" class="h-3.5 w-3.5"></i>
                            Lihat Instagram
                          </a>
                          <button type="button" data-project-video="${esc(String(p.id))}" title="${p.video_url ? 'Tonton video' : 'Video belum tersedia'}" class="${p.video_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-red-900 hover:shadow-none'} inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-red-900 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md">
                            <i data-lucide="play" class="h-3.5 w-3.5"></i>
                            ${p.video_url ? 'Tonton Video' : 'Video Segera Hadir'}
                          </button>
                        </div>`
                      : `<button type="button" data-project-video="${esc(String(p.id))}" title="${p.video_url ? 'Tonton video' : 'Video belum tersedia'}" class="${p.video_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-red-900 hover:shadow-none'} inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-red-900 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md">
                            <i data-lucide="play" class="h-3.5 w-3.5"></i>
                            ${p.video_url ? 'Tonton Video' : 'Video Segera Hadir'}
                          </button>`
                    )
                  : `<div class="grid grid-cols-2 gap-2">
                      <a href="${p.github_url ? esc(p.github_url) : '#'}" ${p.github_url ? '' : 'onclick="return false;"'} title="${p.github_url ? 'Buka repository GitHub' : 'Repository belum tersedia'}" class="${p.github_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-slate-950 hover:shadow-none'} inline-flex items-center justify-center gap-1.5 rounded-lg bg-slate-950 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md">
                        <i data-lucide="github" class="h-3.5 w-3.5"></i>
                        GitHub
                      </a>
                      <a href="${p.link_url ? esc(p.link_url) : '#'}" ${p.link_url ? '' : 'onclick="return false;"'} title="${p.link_url ? 'Buka demo langsung' : 'Demo belum tersedia'}" class="${p.link_url ? '' : 'cursor-not-allowed opacity-45 hover:translate-y-0 hover:bg-red-900 hover:shadow-none'} inline-flex items-center justify-center gap-1.5 rounded-lg bg-red-900 px-3 py-2 text-xs font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-800 hover:shadow-md">
                        <i data-lucide="external-link" class="h-3.5 w-3.5"></i>
                        Live Demo
                      </a>
                    </div>`}
                <button type="button" data-project-detail="${esc(String(p.id))}" class="group/detail mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg border border-stone-200 bg-white px-3 py-2 text-xs font-bold uppercase tracking-wide text-slate-700 transition-all duration-200 hover:border-red-300 hover:bg-red-50 hover:text-red-900">
                  Lihat Detail Proyek
                  <i data-lucide="book-open" class="h-3.5 w-3.5 transition-transform duration-200 group-hover/detail:translate-x-0.5"></i>
                </button>
              </div>
            </div>
          </div>
        </article>`;

      const emptyState = `
        <div class="flex w-full max-w-md items-center justify-center gap-3 rounded-2xl border border-dashed border-stone-300 p-10 text-sm text-slate-500">
          <i data-lucide="folder-open" class="h-6 w-6 shrink-0"></i>
          <span>Belum ada proyek di kategori ini.</span>
        </div>`;

      const ACTIVE = ['border-red-900', 'bg-red-900', 'text-white', 'shadow-sm'];
      const IDLE = ['border-stone-300', 'bg-white', 'text-slate-600', 'hover:border-red-500', 'hover:text-red-900'];

      function renderProjects(filter) {
        let list = allProjects;
        if (filter === 'web') list = allProjects.filter((p) => p.project_type === 'web');
        if (filter === 'video') list = allProjects.filter((p) => p.project_type === 'video');

        projectsTrack.innerHTML = list.length ? list.map(horizontalCard).join('') : emptyState;

        if (projectsCounter) {
          projectsCounter.textContent = list.length
            ? `01 / ${String(list.length).padStart(2, '0')}`
            : '—';
        }

        if (window.lucide) lucide.createIcons();
        if (window.ScrollTrigger) ScrollTrigger.refresh();
        if (window.refreshProjectsNav) window.refreshProjectsNav();
      }

      projectFilters.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-filter]');
        if (!btn) return;
        projectFilters.querySelectorAll('[data-filter]').forEach((b) => {
          b.classList.remove(...ACTIVE);
          b.classList.add(...IDLE);
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.remove(...IDLE);
        btn.classList.add(...ACTIVE);
        btn.setAttribute('aria-pressed', 'true');
        renderProjects(btn.dataset.filter);
      });
    }

    // ============================================================
    //  Horizontal Scroll Proyek — GSAP ScrollTrigger
    //  Desktop (≥769px) : section di-pin; kartu bergerak horizontal
    //                     (translateX) mengikuti scroll vertikal,
    //                     lalu pin dilepas menuju section berikutnya.
    //  Mobile/tablet    : native horizontal swipe (CSS overflow-x +
    //                     scroll-snap), tanpa pinning / scroll-jacking.
    //  Navigasi panah   : desktop → geser posisi scroll pin satu kartu;
    //                      mobile  → viewport.scrollBy satu lebar kartu.
    // ============================================================
    function initHorizontalProjects() {
      const section = document.getElementById('projects');
      const track = document.getElementById('projects-track');
      const viewport = document.getElementById('projects-viewport');
      const progressBar = document.getElementById('projects-progress-bar');
      const hint = document.getElementById('projects-hint');
      const counter = document.getElementById('projects-counter');
      const prevBtn = document.getElementById('projects-prev');
      const nextBtn = document.getElementById('projects-next');

      const isMobileNav = () => window.matchMedia('(max-width: 768px)').matches;

      // State bersama untuk tombol navigasi
      let navProgress = 0;       // progress desktop (0..1)
      let desktopStepper = null; // dipasang dari blok desktop di bawah

      const cardCount = () => track.querySelectorAll('.project-card-wrap').length;

      function setDisabled(btn, disabled) {
        if (btn) btn.disabled = disabled;
      }

      function updateNavButtons(atStart, atEnd) {
        setDisabled(prevBtn, atStart);
        setDisabled(nextBtn, atEnd);
      }

      function mobileNavState() {
        const atStart = viewport.scrollLeft <= 1;
        const atEnd = viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 1;
        return { atStart, atEnd };
      }

      function refreshNavState() {
        if (!track || !viewport) return;
        const single = cardCount() <= 1;
        if (isMobileNav()) {
          const s = mobileNavState();
          updateNavButtons(s.atStart, s.atEnd);
        } else {
          updateNavButtons(single || navProgress <= 0.005, single || navProgress >= 0.995);
        }
      }
      // Dipakai ulang oleh renderProjects setelah filter mengganti isi track
      window.refreshProjectsNav = refreshNavState;

      // Sinkronkan state tombol saat melewati breakpoint mobile/desktop
      const navMQ = window.matchMedia('(max-width: 768px)');
      const onNavMediaChange = () => refreshNavState();
      if (navMQ.addEventListener) navMQ.addEventListener('change', onNavMediaChange);
      else navMQ.addListener(onNavMediaChange); // fallback browser lama

      // ===== Mobile: native scroll — satu kartu per klik =====
      function stepMobile(dir) {
        if (!track || !viewport) return;
        const card = track.querySelector('.project-card-wrap');
        if (!card) return;
        const gap = parseFloat(getComputedStyle(track).gap) || 0;
        const dist = card.getBoundingClientRect().width + gap;
        viewport.scrollBy({ left: dir * dist, behavior: 'smooth' });
      }

      // Update state tombol dinamis saat scroll (mobile)
      if (viewport) {
        viewport.addEventListener('scroll', () => {
          if (!isMobileNav()) return;
          const s = mobileNavState();
          updateNavButtons(s.atStart, s.atEnd);
        });
      }

      // Handler klik bersama — perilaku dibedakan mobile vs desktop
      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          if (isMobileNav()) stepMobile(-1);
          else if (desktopStepper) desktopStepper(-1);
        });
        nextBtn.addEventListener('click', () => {
          if (isMobileNav()) stepMobile(1);
          else if (desktopStepper) desktopStepper(1);
        });
      }

      if (!window.gsap || !window.ScrollTrigger || !section || !track || !viewport) {
        // GSAP gagal dimuat → aktifkan native scroll sebagai pengganti
        if (viewport) viewport.classList.add('no-gsap-fallback');
        refreshNavState();
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      const mm = gsap.matchMedia();

      // ---- Desktop saja: pin + geser horizontal ----
      mm.add('(min-width: 769px)', () => {
        const getScrollAmount = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
        const triggerCfg = () => ({
          trigger: section,
          start: 'top top',
          end: () => '+=' + getScrollAmount(),
          scrub: 1,
          invalidateOnRefresh: true,
        });

        // Geser track dari kanan ke kiri seiring scroll vertikal
        const tween = gsap.to(track, {
          x: () => -getScrollAmount(),
          ease: 'none',
          scrollTrigger: { ...triggerCfg(), pin: true, anticipatePin: 1 },
        });
        const st = tween.scrollTrigger;

        // Progress bar horizontal (bagian bawah section)
        if (progressBar) {
          gsap.fromTo(
            progressBar,
            { scaleX: 0 },
            { scaleX: 1, ease: 'none', scrollTrigger: { ...triggerCfg(), scrub: 0.3 } }
          );
        }

        // Indikator 'scroll to explore' memudar + penghitung kartu aktif
        ScrollTrigger.create({
          ...triggerCfg(),
          onUpdate: (self) => {
            navProgress = self.progress;
            if (hint) hint.style.opacity = Math.max(0, 1 - self.progress * 8);
            if (counter) {
              const n = cardCount();
              if (n > 0) {
                const i = Math.min(n - 1, Math.round(self.progress * (n - 1)));
                counter.textContent = `${String(i + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
              }
            }
            refreshNavState();
          },
        });

        // ===== Desktop: satu klik = majukan scroll pin satu kartu =====
        desktopStepper = (dir) => {
          const n = cardCount();
          if (n <= 1 || !st) return;
          const step = 1 / (n - 1);
          const target = Math.min(1, Math.max(0, navProgress + dir * step));
          const y = st.start + (st.end - st.start) * target;
          window.scrollTo({ top: y, behavior: 'smooth' });
        };

        refreshNavState();
      });

      // State awal (terutama untuk mobile sebelum onUpdate berjalan)
      refreshNavState();
    }
    initHorizontalProjects();

    // ============================================================
    //  Hover 3D ringan pada kartu proyek (desktop, pointer halus)
    //  Pakai event delegation agar tetap berlaku setelah filter
    //  me-render ulang kartu di dalam track.
    // ============================================================
    (function initCardTilt() {
      const track = document.getElementById('projects-track');
      const finePointer = window.matchMedia('(pointer: fine)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!track || !finePointer.matches || reducedMotion.matches) return;

      let activeCard = null;

      track.addEventListener('pointermove', (e) => {
        const card = e.target.closest('.project-card');
        if (card !== activeCard) {
          if (activeCard) {
            activeCard.style.transform = '';
            activeCard.style.transition = '';
          }
          activeCard = card;
        }
        if (!card) return;
        const rect = card.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width - 0.5;
        const py = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform =
          `perspective(900px) rotateY(${px * 5}deg) rotateX(${-py * 5}deg) scale(1.03) translateY(-4px)`;
        card.style.transition = 'transform 120ms ease-out';
      });

      track.addEventListener('pointerleave', () => {
        if (activeCard) {
          activeCard.style.transform = '';
          activeCard.style.transition = '';
          activeCard = null;
        }
      });
    })();

    // ============================================================
    //  Modal Case Study / Detail Proyek
    //  Membuka detail (Role, Masalah, Solusi, Fitur Utama, Tech
    //  Stack) saat tombol "Lihat Detail Proyek" pada kartu diklik.
    // ============================================================
    (function initProjectModal() {
      const modal = document.getElementById('project-modal');
      const backdrop = document.getElementById('project-modal-backdrop');
      const closeBtn = document.getElementById('project-modal-close');
      const img = document.getElementById('project-modal-img');
      const typeBadge = document.getElementById('project-modal-type');
      const titleEl = document.getElementById('project-modal-title');
      const roleEl = document.getElementById('project-modal-role');
      const problemEl = document.getElementById('project-modal-problem');
      const solutionEl = document.getElementById('project-modal-solution');
      const featuresEl = document.getElementById('project-modal-features');
      const techEl = document.getElementById('project-modal-tech');
      const githubBtn = document.getElementById('project-modal-github');
      const demoBtn = document.getElementById('project-modal-demo');
      const panel = document.getElementById('project-modal-panel');
      const metricsEl = document.getElementById('project-modal-metrics');
      const techLabelEl = document.getElementById('project-modal-tech-label');
      const galleryEl = document.getElementById('project-modal-gallery');
      const galleryStrip = document.getElementById('project-modal-gallery-strip');
      const durationEl = document.getElementById('project-modal-duration');
      const webActions = document.getElementById('project-modal-web-actions');
      const watchBtn = document.getElementById('project-modal-watch');

      if (!modal || !backdrop || !closeBtn) return;

      let modalTrigger = null; // elemen pembuka, untuk fokus kembali saat ditutup
      let currentProject = null; // proyek yang sedang dibuka (untuk tombol Tonton Video)

      const esc = (s) =>
        String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      function openProjectModal(id, triggerEl) {
        const p = (window.__projectsData || []).find((x) => String(x.id) === String(id));
        if (!p) return;

        modalTrigger = triggerEl || null;

        if (img) {
          if (p.image) {
            img.src = '/images/' + p.image;
            img.alt = p.title;
            img.classList.remove('hidden');
          } else {
            img.classList.add('hidden');
          }
        }
        // Gallery thumbnails
        if (galleryEl && galleryStrip) {
          const gallery = p.gallery || [];
          if (gallery.length > 1) {
            galleryEl.classList.remove('hidden');
            galleryStrip.innerHTML = gallery
              .map((file, i) => {
                const isActive = i === 0 ? 'ring-2 ring-red-900 opacity-100' : 'opacity-60 hover:opacity-100';
                return `<button type="button" data-gallery-idx="${i}" data-gallery-src="/images/${esc(file)}" title="Gambar ${i + 1}" class="${isActive} h-14 w-20 shrink-0 overflow-hidden rounded-lg bg-slate-200 transition-all duration-200 hover:ring-2 hover:ring-red-900">
                  <img src="/images/${esc(file)}" alt="Gambar ${i + 1}" loading="lazy" class="h-full w-full object-cover" />
                </button>`;
              })
              .join('');
          } else {
            galleryEl.classList.add('hidden');
            galleryStrip.innerHTML = '';
          }
        }
        if (typeBadge) typeBadge.textContent = p.project_type === 'video' ? '🎬 Video & Film' : '💻 Web App';
        if (titleEl) titleEl.textContent = p.title;
        if (roleEl) roleEl.textContent = p.role || '-';
        if (problemEl) problemEl.textContent = p.problem || 'Belum ada catatan masalah.';
        if (solutionEl) solutionEl.textContent = p.solution || 'Belum ada catatan solusi.';

        if (featuresEl) {
          const feats = (p.features || '').split(',').map((f) => f.trim()).filter(Boolean);
          featuresEl.innerHTML = feats.length
            ? feats
                .map(
                  (f) =>
                    `<li class="flex items-start gap-2 text-sm text-slate-600"><i data-lucide="check-circle-2" class="mt-0.5 h-4 w-4 shrink-0 text-red-900"></i><span>${esc(f)}</span></li>`
                )
                .join('')
            : '<li class="text-sm text-slate-500">Belum ada daftar fitur.</li>';
        }

        if (techEl) {
          const tags = (p.tech_stack || '').split(',').map((t) => t.trim()).filter(Boolean);
          techEl.innerHTML = tags.length
            ? tags
                .map((t) => `<span class="rounded-md bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-700">${esc(t)}</span>`)
                .join('')
            : '';
        }

        // Metrik proyek nyata (mis. "8+ Tabel Database Relasional")
        if (metricsEl) {
          const m = (p.metrics || '').split(',').map((x) => x.trim()).filter(Boolean);
          metricsEl.innerHTML = m.length
            ? m
                .map(
                  (x) =>
                    `<span class="rounded-lg border border-stone-200 bg-stone-50 px-3 py-2 text-xs font-semibold text-slate-700">${esc(x)}</span>`
                )
                .join('')
            : '';
          const wrap = document.getElementById('project-modal-metrics-wrap');
          if (wrap) wrap.classList.toggle('hidden', m.length === 0);
        }

        // Label tech stack / peralatan (khusus video)
        if (techLabelEl) techLabelEl.textContent = p.project_type === 'video' ? 'Peralatan & Software' : 'Tech Stack';

        // Durasi video
        if (durationEl) {
          if (p.project_type === 'video' && p.duration) {
            durationEl.classList.remove('hidden');
            durationEl.textContent = '▶ ' + p.duration;
          } else {
            durationEl.classList.add('hidden');
          }
        }

        // Aksi footer: web (GitHub/Live) vs video (Tonton Video)
        currentProject = p;
        if (webActions) {
          const showWebActions = p.project_type !== 'video' || (p.project_type === 'video' && p.link_url);
          webActions.classList.toggle('hidden', !showWebActions);
          // Sembunyikan tombol GitHub untuk video proyek
          if (githubBtn) githubBtn.classList.toggle('hidden', p.project_type === 'video');
          // Ubah label tombol demo
          if (demoBtn) {
            const demoLabel = demoBtn.querySelector('span:last-child') || demoBtn;
            if (p.project_type === 'video' && p.link_url) {
              demoBtn.innerHTML = '<i data-lucide="external-link" class="h-4 w-4"></i> Lihat Instagram';
              lucide.createIcons();
            } else {
              demoBtn.innerHTML = '<i data-lucide="external-link" class="h-4 w-4"></i> Live Demo';
              lucide.createIcons();
            }
          }
        }
        if (watchBtn) {
          const isVideo = p.project_type === 'video';
          watchBtn.classList.toggle('hidden', !isVideo);
          if (isVideo) {
            watchBtn.classList.toggle('opacity-45', !p.video_url);
            watchBtn.classList.toggle('cursor-not-allowed', !p.video_url);
            watchBtn.innerHTML = p.video_url
              ? '<i data-lucide="play" class="h-4 w-4"></i> Tonton Video'
              : '<i data-lucide="play" class="h-4 w-4"></i> Video Segera Hadir';
          }
        }

        if (githubBtn) {
          if (p.github_url) {
            githubBtn.href = p.github_url;
            githubBtn.classList.remove('pointer-events-none', 'opacity-45');
          } else {
            githubBtn.href = '#';
            githubBtn.classList.add('pointer-events-none', 'opacity-45');
          }
        }
        if (demoBtn) {
          if (p.link_url) {
            demoBtn.href = p.link_url;
            demoBtn.classList.remove('pointer-events-none', 'opacity-45');
          } else {
            demoBtn.href = '#';
            demoBtn.classList.add('pointer-events-none', 'opacity-45');
          }
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        if (panel) panel.scrollTop = 0; // mulai dari atas setiap kali dibuka
        document.body.style.overflow = 'hidden';
        if (closeBtn) closeBtn.focus(); // aksesibilitas: fokus masuk ke modal
        if (window.lucide) lucide.createIcons();
      }

      function closeProjectModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
        // kembalikan fokus ke tombol pembuka
        if (modalTrigger && typeof modalTrigger.focus === 'function') modalTrigger.focus();
        modalTrigger = null;
      }

      window.openProjectModal = openProjectModal;

      closeBtn.addEventListener('click', closeProjectModal);
      backdrop.addEventListener('click', closeProjectModal);
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || modal.classList.contains('hidden')) return;
        // Jangan tutup modal case study jika lightbox video masih terbuka di atasnya
        const videoModal = document.getElementById('video-modal');
        if (videoModal && !videoModal.classList.contains('hidden')) return;
        closeProjectModal();
      });

      // Tombol Tonton Video di dalam modal case study
      if (watchBtn) {
        watchBtn.addEventListener('click', () => {
          if (currentProject && currentProject.video_url && window.openProjectVideo) {
            window.openProjectVideo(currentProject.video_url, watchBtn);
          }
        });
      }

      // Gallery thumbnail click: swap main image
      if (galleryStrip) {
        galleryStrip.addEventListener('click', (e) => {
          const thumb = e.target.closest('[data-gallery-src]');
          if (!thumb) return;
          if (img) {
            img.src = thumb.dataset.gallerySrc;
          }
          // Highlight active thumbnail
          galleryStrip.querySelectorAll('[data-gallery-idx]').forEach((b) => {
            b.classList.remove('ring-2', 'ring-red-900', 'opacity-100');
            b.classList.add('opacity-60');
          });
          thumb.classList.remove('opacity-60');
          thumb.classList.add('ring-2', 'ring-red-900', 'opacity-100');
        });
      }

      // Delegasi klik tombol "Lihat Detail Proyek" di kartu
      // (tetap berlaku setelah filter me-render ulang kartu)
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-project-detail]');
        if (btn) openProjectModal(btn.dataset.projectDetail, btn);
      });
    })();

    // ============================================================
    //  Video Lightbox — embed player karya video proyek
    // ============================================================
    (function initVideoModal() {
      const modal = document.getElementById('video-modal');
      const backdrop = document.getElementById('video-modal-backdrop');
      const closeBtn = document.getElementById('video-modal-close');
      const frame = document.getElementById('video-modal-frame');

      if (!modal || !frame) return;

      let videoTrigger = null;

      // Ubah link YouTube biasa menjadi URL embed
      function toEmbed(url) {
        if (!url) return '';
        const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{6,})/);
        if (m) return 'https://www.youtube.com/embed/' + m[1] + '?autoplay=1&rel=0';
        if (/youtube(-nocookie)?\.com\/embed\//.test(url)) return url;
        return url; // asumsikan sudah bisa di-embed
      }

      function openVideoModal(url, triggerEl) {
        videoTrigger = triggerEl || null;
        frame.src = toEmbed(url);
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        if (closeBtn) closeBtn.focus();
      }

      function closeVideoModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        frame.src = ''; // hentikan pemutaran
        // Hanya lepaskan kunci scroll jika modal case study juga sudah tertutup
        const caseModal = document.getElementById('project-modal');
        if (!caseModal || caseModal.classList.contains('hidden')) {
          document.body.style.overflow = '';
        }
        if (videoTrigger && typeof videoTrigger.focus === 'function') videoTrigger.focus();
        videoTrigger = null;
      }

      window.openProjectVideo = openVideoModal;

      if (closeBtn) closeBtn.addEventListener('click', closeVideoModal);
      if (backdrop) backdrop.addEventListener('click', closeVideoModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeVideoModal();
      });

      // Tombol "Tonton Video" pada kartu proyek video
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-project-video]');
        if (!btn) return;
        const p = (window.__projectsData || []).find((x) => String(x.id) === String(btn.dataset.projectVideo));
        if (p && p.video_url) openVideoModal(p.video_url, btn);
      });
    })();
  </script>
</body>
</html>
