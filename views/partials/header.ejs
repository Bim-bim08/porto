<body class="bg-white text-slate-900 font-sans antialiased">

  <!-- ============================================================
       NAVBAR — Iron Spider (navy + gold, minimalis)
  ============================================================ -->
  <header class="hero-header-intro fixed inset-x-0 top-0 z-50 border-b border-stone-200 bg-white/95 backdrop-blur-md">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
      <!-- Logo kiri (logo.png terbaru) -->
      <a href="#home" class="group flex items-center gap-2.5">
        <img
          src="/images/logo.png"
          alt="Logo Bima Respati"
          class="h-9 w-auto object-contain transition-transform duration-300 group-hover:-rotate-12 md:h-10"
        />
        <span class="font-heading text-base font-extrabold tracking-tight text-slate-950">
          Bima&nbsp;Respati
        </span>
      </a>

      <!-- Menu tengah -->
      <ul class="hidden items-center gap-1 md:flex">
        <% const navLinks = [
          { href: '#home',     label: 'Portofolio'  },
          { href: '#about',    label: 'Tentang Saya' },
          { href: '#projects', label: 'Proyek'      },
          { href: '#contact',  label: 'Kontak'      },
        ]; %>
        <% navLinks.forEach((link) => { %>
          <li>
            <a href="<%= link.href %>" class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-600 transition-colors duration-200 hover:bg-stone-100 hover:text-slate-950">
              <%= link.label %>
            </a>
          </li>
        <% }) %>
      </ul>

      <!-- Aksi kanan -->
      <div class="flex items-center gap-2">
        <a
          href="#contact"
          class="hidden rounded-full bg-slate-950 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:bg-red-900 hover:shadow-md sm:inline-flex"
        >
          Hubungi Saya
        </a>

        <!-- Hamburger (mobile) -->
        <button
          id="menu-toggle"
          type="button"
          aria-label="Buka menu"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-stone-200 text-slate-600 md:hidden"
        >
          <i data-lucide="menu" class="h-5 w-5"></i>
        </button>
      </div>
    </nav>

    <!-- Menu mobile -->
    <div id="mobile-menu" class="hidden border-t border-stone-200 bg-white/95 backdrop-blur-md md:hidden">
      <ul class="space-y-1 px-4 py-3">
        <% navLinks.forEach((link) => { %>
          <li>
            <a href="<%= link.href %>" class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:bg-red-50 hover:text-red-900">
              <%= link.label %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  </header>
